{
  "name": "novel-helper",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.2",
  "publisher": "dreaife",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hebi8/novel-helper"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "novel",
    "fiction",
    "writing",
    "lore",
    "小说",
    "写作",
    "续写",
    "设定"
  ],
  "l10n": "./l10n",
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:plaintext"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrustedWorkspaces%",
      "restrictedConfigurations": [
        "novelHelper.provider",
        "novelHelper.anthropic.model",
        "novelHelper.openai.model",
        "novelHelper.deepseek.model",
        "novelHelper.gemini.model",
        "novelHelper.openaiCompatible.baseUrl",
        "novelHelper.openaiCompatible.model",
        "novelHelper.extraRequestBody",
        "novelHelper.usage.prices",
        "novelHelper.usage.dailyLimitUsd"
      ]
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novelHelper",
          "title": "%view.container%",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "novelHelper": [
        {
          "id": "novelHelper.book",
          "name": "%view.book%"
        },
        {
          "id": "novelHelper.lore",
          "name": "%view.lore%"
        },
        {
          "id": "novelHelper.settings",
          "name": "%view.settings%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "novelHelper.book",
        "contents": "%welcome.noFolder%",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "novelHelper.book",
        "contents": "%welcome.empty%",
        "when": "workspaceFolderCount > 0 && novelHelper.workspace == empty"
      },
      {
        "view": "novelHelper.lore",
        "contents": "%welcome.noFolder%",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "novelHelper.lore",
        "contents": "%welcome.empty%",
        "when": "workspaceFolderCount > 0 && novelHelper.workspace == empty"
      },
      {
        "view": "novelHelper.lore",
        "contents": "%welcome.noLore%",
        "when": "workspaceFolderCount > 0 && novelHelper.workspace == ready"
      },
      {
        "view": "novelHelper.lore",
        "contents": "%welcome.elsewhere%",
        "when": "workspaceFolderCount > 0 && novelHelper.workspace == elsewhere"
      }
    ],
    "commands": [
      {
        "command": "novelHelper.toggle",
        "title": "%command.toggle%",
        "category": "Novel Helper"
      },
      {
        "command": "novelHelper.setApiKey",
        "title": "%command.setApiKey%",
        "category": "Novel Helper"
      },
      {
        "command": "novelHelper.showLastRequest",
        "title": "%command.showLastRequest%",
        "category": "Novel Helper"
      },
      {
        "command": "novelHelper.showUsage",
        "title": "%command.showUsage%",
        "category": "Novel Helper"
      },
      {
        "command": "novelHelper.init",
        "title": "%command.init%",
        "category": "Novel Helper"
      },
      {
        "command": "novelHelper.selectStoryFolder",
        "title": "%command.selectStoryFolder%",
        "category": "Novel Helper"
      },
      {
        "command": "novelHelper.toggleTrigger",
        "title": "%command.toggleTrigger%",
        "category": "Novel Helper"
      },
      {
        "command": "novelHelper.selectProvider",
        "title": "%command.selectProvider%",
        "category": "Novel Helper"
      },
      {
        "command": "novelHelper.setModel",
        "title": "%command.setModel%",
        "category": "Novel Helper"
      },
      {
        "command": "novelHelper.setDailyLimit",
        "title": "%command.setDailyLimit%",
        "category": "Novel Helper"
      },
      {
        "command": "novelHelper.book.newChapter",
        "title": "%command.book.newChapter%",
        "category": "Novel Helper",
        "icon": "$(new-file)"
      },
      {
        "command": "novelHelper.book.newLevel",
        "title": "%command.book.newLevel%",
        "category": "Novel Helper",
        "icon": "$(new-folder)"
      },
      {
        "command": "novelHelper.book.openOutline",
        "title": "%command.book.openOutline%",
        "category": "Novel Helper",
        "icon": "$(list-tree)"
      },
      {
        "command": "novelHelper.book.openSummary",
        "title": "%command.book.openSummary%",
        "category": "Novel Helper",
        "icon": "$(note)"
      },
      {
        "command": "novelHelper.book.rename",
        "title": "%command.book.rename%",
        "category": "Novel Helper",
        "icon": "$(edit)"
      },
      {
        "command": "novelHelper.lore.new",
        "title": "%command.lore.new%",
        "category": "Novel Helper",
        "icon": "$(add)"
      },
      {
        "command": "novelHelper.lore.pin",
        "title": "%command.lore.pin%",
        "category": "Novel Helper",
        "icon": "$(pin)"
      },
      {
        "command": "novelHelper.lore.unpin",
        "title": "%command.lore.unpin%",
        "category": "Novel Helper",
        "icon": "$(pinned)"
      },
      {
        "command": "novelHelper.lore.setAliases",
        "title": "%command.lore.setAliases%",
        "category": "Novel Helper",
        "icon": "$(tag)"
      },
      {
        "command": "novelHelper.lore.setType",
        "title": "%command.lore.setType%",
        "category": "Novel Helper",
        "icon": "$(symbol-class)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "novelHelper.book.newChapter",
          "when": "view == novelHelper.book",
          "group": "navigation@1"
        },
        {
          "command": "novelHelper.book.newLevel",
          "when": "view == novelHelper.book",
          "group": "navigation@2"
        },
        {
          "command": "novelHelper.init",
          "when": "view == novelHelper.book",
          "group": "1_init@1"
        },
        {
          "command": "novelHelper.selectStoryFolder",
          "when": "view == novelHelper.book",
          "group": "1_init@2"
        },
        {
          "command": "novelHelper.lore.new",
          "when": "view == novelHelper.lore",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "novelHelper.book.openOutline",
          "when": "view == novelHelper.book",
          "group": "inline@1"
        },
        {
          "command": "novelHelper.book.openSummary",
          "when": "view == novelHelper.book && viewItem == chapter",
          "group": "inline@2"
        },
        {
          "command": "novelHelper.book.newChapter",
          "when": "view == novelHelper.book && viewItem =~ /^(book|level)$/",
          "group": "inline@3"
        },
        {
          "command": "novelHelper.book.newLevel",
          "when": "view == novelHelper.book && viewItem =~ /^(book|level)$/",
          "group": "inline@4"
        },
        {
          "command": "novelHelper.book.openOutline",
          "when": "view == novelHelper.book",
          "group": "1_open@1"
        },
        {
          "command": "novelHelper.book.openSummary",
          "when": "view == novelHelper.book && viewItem == chapter",
          "group": "1_open@2"
        },
        {
          "command": "novelHelper.book.newChapter",
          "when": "view == novelHelper.book",
          "group": "2_new@1"
        },
        {
          "command": "novelHelper.book.newLevel",
          "when": "view == novelHelper.book && viewItem =~ /^(book|level)$/",
          "group": "2_new@2"
        },
        {
          "command": "novelHelper.book.rename",
          "when": "view == novelHelper.book && viewItem =~ /^(level|chapter)$/",
          "group": "3_rename"
        },
        {
          "command": "novelHelper.lore.pin",
          "when": "view == novelHelper.lore && viewItem == entry",
          "group": "inline@1"
        },
        {
          "command": "novelHelper.lore.unpin",
          "when": "view == novelHelper.lore && viewItem == entryAlways",
          "group": "inline@1"
        },
        {
          "command": "novelHelper.lore.setAliases",
          "when": "view == novelHelper.lore && viewItem =~ /^entry/",
          "group": "inline@2"
        },
        {
          "command": "novelHelper.lore.new",
          "when": "view == novelHelper.lore && viewItem == group",
          "group": "inline"
        },
        {
          "command": "novelHelper.lore.pin",
          "when": "view == novelHelper.lore && viewItem == entry",
          "group": "1_fields@1"
        },
        {
          "command": "novelHelper.lore.unpin",
          "when": "view == novelHelper.lore && viewItem == entryAlways",
          "group": "1_fields@1"
        },
        {
          "command": "novelHelper.lore.setAliases",
          "when": "view == novelHelper.lore && viewItem =~ /^entry/",
          "group": "1_fields@2"
        },
        {
          "command": "novelHelper.lore.setType",
          "when": "view == novelHelper.lore && viewItem =~ /^entry/",
          "group": "1_fields@3"
        },
        {
          "command": "novelHelper.lore.new",
          "when": "view == novelHelper.lore && viewItem == group",
          "group": "2_new"
        }
      ],
      "commandPalette": [
        {
          "command": "novelHelper.book.openOutline",
          "when": "false"
        },
        {
          "command": "novelHelper.book.openSummary",
          "when": "false"
        },
        {
          "command": "novelHelper.book.rename",
          "when": "false"
        },
        {
          "command": "novelHelper.lore.pin",
          "when": "false"
        },
        {
          "command": "novelHelper.lore.unpin",
          "when": "false"
        },
        {
          "command": "novelHelper.lore.setAliases",
          "when": "false"
        },
        {
          "command": "novelHelper.lore.setType",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "editor.action.inlineSuggest.trigger",
        "key": "alt+\\",
        "when": "editorTextFocus && !editorReadonly && !inlineSuggestionVisible && editorLangId =~ /^(markdown|plaintext)$/"
      }
    ],
    "configuration": {
      "title": "Novel Helper",
      "properties": {
        "novelHelper.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.enabled%"
        },
        "novelHelper.trigger": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "enumDescriptions": [
            "%config.trigger.auto%",
            "%config.trigger.manual%"
          ],
          "default": "auto",
          "markdownDescription": "%config.trigger%"
        },
        "novelHelper.debounceMs": {
          "type": "number",
          "default": 750,
          "minimum": 100,
          "markdownDescription": "%config.debounceMs%"
        },
        "novelHelper.maxSuggestionChars": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "markdownDescription": "%config.maxSuggestionChars%"
        },
        "novelHelper.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "deepseek",
            "gemini",
            "openaiCompatible"
          ],
          "enumDescriptions": [
            "%config.provider.anthropic%",
            "%config.provider.openai%",
            "%config.provider.deepseek%",
            "%config.provider.gemini%",
            "%config.provider.openaiCompatible%"
          ],
          "default": "anthropic",
          "markdownDescription": "%config.provider%"
        },
        "novelHelper.anthropic.model": {
          "type": "string",
          "default": "claude-haiku-5-5",
          "markdownDescription": "%config.anthropic.model%"
        },
        "novelHelper.openai.model": {
          "type": "string",
          "default": "gpt-6-luna",
          "markdownDescription": "%config.openai.model%"
        },
        "novelHelper.deepseek.model": {
          "type": "string",
          "default": "deepseek-flash",
          "markdownDescription": "%config.deepseek.model%"
        },
        "novelHelper.gemini.model": {
          "type": "string",
          "default": "gemini-3.5-flash-lite",
          "markdownDescription": "%config.gemini.model%"
        },
        "novelHelper.openaiCompatible.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "markdownDescription": "%config.openaiCompatible.baseUrl%"
        },
        "novelHelper.openaiCompatible.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.openaiCompatible.model%"
        },
        "novelHelper.extraRequestBody": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.extraRequestBody%"
        },
        "novelHelper.usage.prices": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "required": [
              "input",
              "output"
            ],
            "properties": {
              "input": {
                "type": "number"
              },
              "output": {
                "type": "number"
              },
              "cacheRead": {
                "type": "number"
              },
              "cacheWrite": {
                "type": "number"
              }
            }
          },
          "markdownDescription": "%config.usage.prices%"
        },
        "novelHelper.usage.dailyLimitUsd": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.usage.dailyLimitUsd%"
        },
        "novelHelper.files.storyFolder": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%config.files.storyFolder%"
        },
        "novelHelper.files.lore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "{设定,人物,角色,资料,世界观,lore,characters,worldbuilding}/**/*.{md,txt}"
          ],
          "scope": "resource",
          "markdownDescription": "%config.files.lore%"
        },
        "novelHelper.files.chapters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "{正文,章节,chapters,manuscript}/**/*.{md,txt}"
          ],
          "scope": "resource",
          "markdownDescription": "%config.files.chapters%"
        },
        "novelHelper.files.outlines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "{大纲,细纲,outline,outlines}/**/*.{md,txt}"
          ],
          "scope": "resource",
          "markdownDescription": "%config.files.outlines%"
        },
        "novelHelper.files.summaries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "{摘要,summary,summaries}/**/*.{md,txt}"
          ],
          "scope": "resource",
          "markdownDescription": "%config.files.summaries%"
        },
        "novelHelper.files.bookNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "全书",
            "总纲",
            "book"
          ],
          "scope": "resource",
          "markdownDescription": "%config.files.bookNames%"
        },
        "novelHelper.context.beforeChars": {
          "type": "number",
          "default": 6000,
          "minimum": 0,
          "markdownDescription": "%config.context.beforeChars%",
          "scope": "resource"
        },
        "novelHelper.context.afterChars": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "markdownDescription": "%config.context.afterChars%",
          "scope": "resource"
        },
        "novelHelper.context.alwaysChars": {
          "type": "number",
          "default": 1500,
          "minimum": 0,
          "markdownDescription": "%config.context.alwaysChars%",
          "scope": "resource"
        },
        "novelHelper.context.matchedChars": {
          "type": "number",
          "default": 2500,
          "minimum": 0,
          "markdownDescription": "%config.context.matchedChars%",
          "scope": "resource"
        },
        "novelHelper.context.entryChars": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "markdownDescription": "%config.context.entryChars%",
          "scope": "resource"
        },
        "novelHelper.context.bookOutlineChars": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "markdownDescription": "%config.context.bookOutlineChars%",
          "scope": "resource"
        },
        "novelHelper.context.levelOutlineChars": {
          "type": "number",
          "default": 800,
          "minimum": 0,
          "markdownDescription": "%config.context.levelOutlineChars%",
          "scope": "resource"
        },
        "novelHelper.context.outlineChars": {
          "type": "number",
          "default": 800,
          "minimum": 0,
          "markdownDescription": "%config.context.outlineChars%",
          "scope": "resource"
        },
        "novelHelper.context.previousChapters": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "markdownDescription": "%config.context.previousChapters%",
          "scope": "resource"
        },
        "novelHelper.context.previousChapterChars": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "markdownDescription": "%config.context.previousChapterChars%",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "pretest": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p . --outDir out",
    "test": "node --test \"out/test/**/*.test.js\"",
    "watch-tests": "tsc -p . -w --outDir out"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.97.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3"
  }
}
