{
	"name": "novel-helper",
	"version": "0.4.0",
	"productName": "Novel Helper",
	"description": "A desktop writing space for long fiction.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Hebi8/novel-helper"
	},
	"main": "dist/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"pretest": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
		"test": "node scripts/test.cjs",
		"e2e": "npm run build && playwright test",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && eslint src e2e electron.vite.config.ts playwright.config.ts --max-warnings 0 && prettier --check .",
		"format": "prettier --write .",
		"pack": "npm run build && electron-builder --mac dir --arm64 --publish never"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^2.6.0",
		"@codemirror/autocomplete": "6.20.4",
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/language": "6.13.1",
		"@codemirror/merge": "6.12.3",
		"@codemirror/search": "6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@playwright/test": "1.65.0",
		"@types/node": "22.20.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"electron": "45.3.2",
		"electron-builder": "26.18.0",
		"electron-vite": "6.0.0",
		"eslint": "10.14.0",
		"prettier": "3.10.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.8"
	},
	"build": {
		"appId": "io.github.hebi8.novelhelper",
		"productName": "Novel Helper",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/main/**/*",
			"dist/preload/**/*",
			"dist/renderer/**/*",
			"package.json",
			"LICENSE",
			"THIRD-PARTY-NOTICES.md"
		],
		"mac": {
			"target": [
				{
					"target": "dir",
					"arch": [
						"arm64"
					]
				}
			],
			"identity": null,
			"notarize": false,
			"category": "public.app-category.productivity"
		},
		"npmRebuild": false
	}
}
